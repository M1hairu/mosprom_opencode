# Скопируйте в .env (make setup делает это сам). .env — в .gitignore; секреты только здесь.

# Минуты без движения до перехвата чужой задачи (scripts/issues.sh take).
# 60 — задача без движения 1 ч освобождается.
TAKEOVER_MIN=60

# Предел размера файла вне Git LFS, МБ (.claude/hooks/check-data-files.sh).
MAX_FILE_MB=5

# Репозиторий шаблона для /retro: owner/hackathon-template
TEMPLATE_REPO=

# Ключи API — сюда, с плейсхолдером в этом файле:
# LLM_API_KEY=your_api_key_here

# docker compose (make demo). Пароль — латиница и цифры: он входит в DATABASE_URL.
POSTGRES_USER=lassard
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lassard
# Порты на хосте. API и PostgreSQL — только 127.0.0.1. SPA (nginx) — все интерфейсы:
# телефон в той же сети открывает /guide.
API_PORT=8000
WEB_PORT=8080
DB_PORT=5432

# Выкладка на сервер команды (make deploy, README «Выкладка»). Значения без кавычек.
# DEPLOY_DOMAIN — A-запись на DEPLOY_HOST; на него Caddy получает сертификат Let's Encrypt.
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_SSH_KEY=~/.ssh/id_ed25519
DEPLOY_PORT=22
# Каталог на сервере, от $HOME пользователя DEPLOY_USER.
DEPLOY_DIR=lassard
DEPLOY_DOMAIN=
DEPLOY_ACME_EMAIL=

# Вход HTTP Basic: editor, manager, expert. Пустой пароль отключает роль.
# На публичной выкладке используйте HTTPS. Значения задайте только в .env.
EDITOR_PASSWORD=
MANAGER_PASSWORD=
EXPERT_PASSWORD=

# Webhook новой заявки (POST JSON). Пусто — не отправляем. Сбой только в лог.
LEADS_WEBHOOK_URL=
